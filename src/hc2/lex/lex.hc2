import "hc2/ast";
import "heap";
import "hc2/diag";
import "sys";

const I64 TK_EOF   = 0;
const I64 TK_IDENT = 1;
const I64 TK_INT   = 2;
const I64 TK_STR   = 3;
const I64 TK_PUNCT = 4;
const I64 TK_FLOAT = 5;

struct Tok {
    I64 kind;
    I64 line;
    I64 col;
    I64 ival;
    I64 toff;
    I64 tlen;
    I64 soff;
    I64 slen;
}

struct Lexer {
    U8* src;
    U8* path;
    I64 pos;
    I64 line;
    I64 col;
    Tok* cur;
    Tok* ring;
    I64 rn;
    I64 dry;
    Tok* scratch;
    ast.Ast* ast;
}

U0 lex_err(Lexer* lx, I64 line, I64 col, U8* msg) {
    "%s:%d:%d: error: %s\n", lx.path, line, col, msg;
    sys.exit(1);
}

Lexer* lex_new(ast.Ast* t, U8* path, U8* src) {
    Lexer* lx = heap.alloc(sizeof(Lexer)) as Lexer*;
    lx.src = src;
    lx.path = path;
    lx.pos = 0;
    lx.line = 1;
    lx.col = 1;
    lx.cur = heap.alloc(sizeof(Tok)) as Tok*;
    lx.ring = heap.alloc(4 * sizeof(Tok)) as Tok*;
    lx.rn = 0;
    lx.dry = 0;
    lx.scratch = heap.alloc(sizeof(Tok)) as Tok*;
    lx.ast = t;
    return lx;
}

I64 _peek(Lexer* lx) {
    if lx.pos >= lx.src.len {
        return -1;
    }
    return lx.src[lx.pos] as I64;
}

I64 _peek2(Lexer* lx) {
    if lx.pos + 1 >= lx.src.len {
        return -1;
    }
    return lx.src[lx.pos + 1] as I64;
}

I64 _adv(Lexer* lx) {
    if lx.pos >= lx.src.len {
        return -1;
    }
    I64 c = lx.src[lx.pos] as I64;
    lx.pos = lx.pos + 1;
    if c == '\n' {
        lx.line = lx.line + 1;
        lx.col = 1;
    } else {
        lx.col = lx.col + 1;
    }
    return c;
}

Bool _is_id1(I64 c) {
    if c >= 'a' && c <= 'z' {
        return true;
    }
    if c >= 'A' && c <= 'Z' {
        return true;
    }
    return c == '_';
}

Bool _is_dig(I64 c) {
    return c >= '0' && c <= '9';
}

Bool _is_idn(I64 c) {
    if _is_id1(c) {
        return true;
    }
    return _is_dig(c);
}

I64 _hexval(I64 c) {
    if _is_dig(c) {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return -1;
}

I64 _escape(Lexer* lx, I64 e) {
    if e == 'n' {
        return '\n';
    }
    if e == 't' {
        return '\t';
    }
    if e == 'r' {
        return '\r';
    }
    if e == '0' {
        return 0;
    }
    if e == '\\' {
        return '\\';
    }
    if e == '"' {
        return '"';
    }
    if e == '\'' {
        return '\'';
    }
    lex_err(lx, lx.line, lx.col, "unknown escape");
    return 0;
}

U0 lex_scan(Lexer* lx, Tok* t) {
    for true {
        I64 c = _peek(lx);
        if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
            _adv(lx);
        } else {
            if c == '/' && _peek2(lx) == '/' {
                for true {
                    I64 d = _peek(lx);
                    if d == -1 || d == '\n' {
                        break;
                    }
                    _adv(lx);
                }
            } else {
                break;
            }
        }
    }
    t.line = lx.line;
    t.col = lx.col;
    t.ival = 0;
    t.toff = lx.pos;
    t.tlen = 0;
    t.soff = 0;
    t.slen = 0;

    I64 c = _peek(lx);
    if c == -1 {
        t.kind = TK_EOF;
        return;
    }
    if _is_id1(c) {
        for _is_idn(_peek(lx)) {
            _adv(lx);
        }
        t.kind = TK_IDENT;
        t.tlen = lx.pos - t.toff;
        return;
    }
    if _is_dig(c) {
        I64 v = 0;
        if c == '0' && _peek2(lx) == 'x' {
            _adv(lx);
            _adv(lx);
            I64 any = 0;
            for true {
                I64 h = _hexval(_peek(lx));
                if h < 0 {
                    break;
                }
                v = v * 16 + h;
                any = 1;
                _adv(lx);
            }
            if any == 0 {
                lex_err(lx, t.line, t.col, "empty hex literal");
            }
        } else {
            for _is_dig(_peek(lx)) {
                v = v * 10 + (_adv(lx) - '0');
            }
            I64 isf = 0;
            if _peek(lx) == '.' && _is_dig(_peek2(lx)) {
                isf = 1;
                _adv(lx);
                for _is_dig(_peek(lx)) {
                    _adv(lx);
                }
            }
            if _peek(lx) == 'e' {
                I64 p2 = _peek2(lx);
                if _is_dig(p2) || p2 == '+' || p2 == '-' {
                    isf = 1;
                    _adv(lx);
                    if _is_dig(_peek(lx)) == false {
                        _adv(lx);
                    }
                    if _is_dig(_peek(lx)) == false {
                        lex_err(lx, t.line, t.col, "a float exponent needs digits");
                    }
                    for _is_dig(_peek(lx)) {
                        _adv(lx);
                    }
                }
            }
            if isf == 1 {
                t.kind = TK_FLOAT;
                t.ival = _f64text(lx, t.toff, lx.pos);
                t.tlen = lx.pos - t.toff;
                return;
            }
        }
        t.kind = TK_INT;
        t.ival = v;
        t.tlen = lx.pos - t.toff;
        return;
    }
    if c == '\'' {
        _adv(lx);
        I64 d = _adv(lx);
        if d == -1 || d == '\n' {
            lex_err(lx, t.line, t.col, "unterminated character literal");
        }
        if d == '\\' {
            d = _escape(lx, _adv(lx));
        }
        if _adv(lx) != '\'' {
            lex_err(lx, t.line, t.col, "expected closing quote");
        }
        t.kind = TK_INT;
        t.ival = d;
        t.tlen = lx.pos - t.toff;
        return;
    }
    if c == '"' {
        _adv(lx);
        ast.Ast* a = lx.ast;
        t.soff = a.sblen;
        for true {
            I64 d = _adv(lx);
            if d == -1 || d == '\n' {
                lex_err(lx, t.line, t.col, "unterminated string literal");
            }
            if d == '"' {
                break;
            }
            if d == '\\' {
                d = _escape(lx, _adv(lx));
            }
            if lx.dry == 0 {
                if a.sblen >= a.sbcap {
                    diag.die("string blob full");
                }
                a.sb[a.sblen] = d as U8;
                a.sblen = a.sblen + 1;
            }
        }
        t.kind = TK_STR;
        t.slen = a.sblen - t.soff;
        t.tlen = lx.pos - t.toff;
        return;
    }
    I64 c1 = _adv(lx);
    I64 c2 = _peek(lx);
    Bool two = false;
    if c1 == '=' && c2 == '=' {
        two = true;
    }
    if c1 == '!' && c2 == '=' {
        two = true;
    }
    if c1 == '<' && c2 == '=' {
        two = true;
    }
    if c1 == '>' && c2 == '=' {
        two = true;
    }
    if c1 == '+' && c2 == '+' {
        two = true;
    }
    if c1 == '-' && c2 == '-' {
        two = true;
    }
    if c1 == '<' && c2 == '<' {
        two = true;
    }
    if c1 == '>' && c2 == '>' {
        two = true;
    }
    if c1 == '&' && c2 == '&' {
        two = true;
    }
    if c1 == '|' && c2 == '|' {
        two = true;
    }
    if two {
        _adv(lx);
    }
    t.kind = TK_PUNCT;
    t.tlen = lx.pos - t.toff;
}

U0 tok_copy(Tok* d, Tok* s) {
    d.kind = s.kind;
    d.line = s.line;
    d.col = s.col;
    d.ival = s.ival;
    d.toff = s.toff;
    d.tlen = s.tlen;
    d.soff = s.soff;
    d.slen = s.slen;
}

U0 lex_next(Lexer* lx) {
    if lx.rn > 0 {
        tok_copy(lx.cur, lx.ring);
        for I64 j = 1; j < lx.rn; j++ {
            tok_copy(lx.ring + (j - 1), lx.ring + j);
        }
        lx.rn = lx.rn - 1;
        return;
    }
    lex_scan(lx, lx.cur);
}

Tok* lex_ahead_at(Lexer* lx, I64 i) {
    if i >= 4 {
        diag.die("lookahead too deep");
    }
    for lx.rn <= i {
        lex_scan(lx, lx.ring + lx.rn);
        lx.rn = lx.rn + 1;
    }
    return lx.ring + i;
}

Tok* lex_ahead(Lexer* lx) {
    return lex_ahead_at(lx, 0);
}

U8* tok_text(Lexer* lx, Tok* t) {
    return lx.src[t.toff : t.toff + t.tlen];
}

Bool lex_fnptr_ahead(Lexer* lx, I64 start) {
    I64 sp = lx.pos;
    I64 sl = lx.line;
    I64 sc = lx.col;
    lx.dry = 1;
    I64 depth = 0;
    I64 i = start;
    Bool ans = false;
    for true {
        Tok* t = lx.scratch;
        if i < lx.rn {
            t = lx.ring + i;
        } else {
            lex_scan(lx, lx.scratch);
            t = lx.scratch;
        }
        i = i + 1;
        if t.kind == TK_EOF {
            break;
        }
        if t.kind == TK_PUNCT && t.tlen == 1 {
            I64 ch = lx.src[t.toff] as I64;
            if ch == '(' {
                depth = depth + 1;
            }
            if ch == ')' {
                depth = depth - 1;
                if depth == 0 {
                    if i < lx.rn {
                        t = lx.ring + i;
                    } else {
                        lex_scan(lx, lx.scratch);
                        t = lx.scratch;
                    }
                    if t.kind == TK_PUNCT && t.tlen == 1 {
                        ans = (lx.src[t.toff] as I64) == '*';
                    }
                    break;
                }
            }
        }
    }
    lx.dry = 0;
    lx.pos = sp;
    lx.line = sl;
    lx.col = sc;
    return ans;
}

I64 _f64text(Lexer* lx, I64 a, I64 b) {
    I64 m = 0;
    I64 sig = 0;
    I64 dexp = 0;
    I64 infrac = 0;
    I64 i = a;
    for i < b {
        I64 c = lx.src[i] as I64;
        i = i + 1;
        if c == '.' {
            infrac = 1;
        } else if c == 'e' {
            I64 es = 1;
            if i < b {
                if lx.src[i] == '+' {
                    i = i + 1;
                } else if lx.src[i] == '-' {
                    es = -1;
                    i = i + 1;
                }
            }
            I64 ev = 0;
            for i < b {
                if ev < 100000 {
                    ev = ev * 10 + (lx.src[i] as I64 - '0');
                }
                i = i + 1;
            }
            dexp = dexp + es * ev;
        } else {
            I64 d = c - '0';
            if m == 0 && d == 0 {
                if infrac == 1 {
                    dexp = dexp - 1;
                }
            } else if sig < 18 {
                m = m * 10 + d;
                sig = sig + 1;
                if infrac == 1 {
                    dexp = dexp - 1;
                }
            } else if infrac == 0 {
                dexp = dexp + 1;
            }
        }
    }
    return _f64bits(m, dexp);
}

I64 _f64bits(I64 m, I64 dexp) {
    if m == 0 {
        return 0;
    }
    U64 hi = m as U64;
    U64 lo = 0;
    I64 bexp = 63;
    for (hi >> 63) == 0 {
        hi = hi << 1;
        bexp = bexp - 1;
    }
    for dexp > 0 {
        lo = (lo >> 4) | (hi << 60);
        hi = hi >> 4;
        bexp = bexp + 4;
        U64 bl = lo & 4294967295;
        U64 al = lo >> 32;
        U64 tl = bl * 10;
        U64 th = al * 10 + (tl >> 32);
        lo = (th << 32) | (tl & 4294967295);
        hi = hi * 10 + (th >> 32);
        for (hi >> 63) == 0 {
            hi = (hi << 1) | (lo >> 63);
            lo = lo << 1;
            bexp = bexp - 1;
        }
        dexp = dexp - 1;
        if bexp > 2100 {
            dexp = 0;
        }
    }
    for dexp < 0 {
        U64 r = hi % 10;
        hi = hi / 10;
        U64 t = r * 4294967296 + (lo >> 32);
        U64 qh = t / 10;
        U64 r2 = t % 10;
        U64 t2 = r2 * 4294967296 + (lo & 4294967295);
        U64 ql = t2 / 10;
        lo = (qh << 32) | ql;
        for (hi >> 63) == 0 {
            hi = (hi << 1) | (lo >> 63);
            lo = lo << 1;
            bexp = bexp - 1;
        }
        dexp = dexp + 1;
        if bexp < -1200 {
            dexp = 0;
        }
    }
    U64 frac = hi >> 11;
    U64 rbit = (hi >> 10) & 1;
    U64 sticky = (hi & 1023) | lo;
    if rbit == 1 {
        if sticky != 0 || (frac & 1) == 1 {
            frac = frac + 1;
            if frac == 9007199254740992 {
                frac = frac >> 1;
                bexp = bexp + 1;
            }
        }
    }
    I64 be = bexp + 1023;
    if be >= 2047 {
        return 0x7ff0000000000000;
    }
    if be <= 0 {
        return 0;
    }
    return (((be as U64) << 52) | (frac & 4503599627370495)) as I64;
}
