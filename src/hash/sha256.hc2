
const I64 _M32 = 4294967295;

I64 _rotr(I64 x, I64 n) {
    return ((x >> n) | (x << (32 - n))) & _M32;
}

I64 _shr(I64 x, I64 n) {
    return (x >> n) & _M32;
}

I64 _sha_k(I64 i) {
    I64 k[64] = {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
        0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
        0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
        0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
        0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
        0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    };
    return k[i];
}

U0 sha256(U8* buf, I64 len, U8* out) {
    I64 h0 = 0x6a09e667;
    I64 h1 = 0xbb67ae85;
    I64 h2 = 0x3c6ef372;
    I64 h3 = 0xa54ff53a;
    I64 h4 = 0x510e527f;
    I64 h5 = 0x9b05688c;
    I64 h6 = 0x1f83d9ab;
    I64 h7 = 0x5be0cd19;

    I64 total = (len + 9 + 63) / 64 * 64;
    I64 w[64] = {};
    for I64 blk = 0; blk < total; blk = blk + 64 {
        for I64 i = 0; i < 16; i++ {
            I64 word = 0;
            for I64 j = 0; j < 4; j++ {
                I64 at = blk + i * 4 + j;
                I64 b = 0;
                if at < len {
                    b = buf[at] as I64;
                } else if at == len {
                    b = 0x80;
                } else if at >= total - 8 {
                    I64 bitlen = len * 8;
                    I64 sh = (total - 1 - at) * 8;
                    b = (bitlen >> sh) & 255;
                }
                word = (word << 8) | b;
            }
            w[i] = word;
        }
        for I64 i = 16; i < 64; i++ {
            I64 s0 = _rotr(w[i - 15], 7) ^ _rotr(w[i - 15], 18) ^ _shr(w[i - 15], 3);
            I64 s1 = _rotr(w[i - 2], 17) ^ _rotr(w[i - 2], 19) ^ _shr(w[i - 2], 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & _M32;
        }
        I64 a = h0;
        I64 b = h1;
        I64 c = h2;
        I64 d = h3;
        I64 e = h4;
        I64 f = h5;
        I64 g = h6;
        I64 h = h7;
        for I64 i = 0; i < 64; i++ {
            I64 S1 = _rotr(e, 6) ^ _rotr(e, 11) ^ _rotr(e, 25);
            I64 ch = (e & f) ^ ((e ^ _M32) & g);
            I64 t1 = (h + S1 + ch + _sha_k(i) + w[i]) & _M32;
            I64 S0 = _rotr(a, 2) ^ _rotr(a, 13) ^ _rotr(a, 22);
            I64 maj = (a & b) ^ (a & c) ^ (b & c);
            I64 t2 = (S0 + maj) & _M32;
            h = g;
            g = f;
            f = e;
            e = (d + t1) & _M32;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & _M32;
        }
        h0 = (h0 + a) & _M32;
        h1 = (h1 + b) & _M32;
        h2 = (h2 + c) & _M32;
        h3 = (h3 + d) & _M32;
        h4 = (h4 + e) & _M32;
        h5 = (h5 + f) & _M32;
        h6 = (h6 + g) & _M32;
        h7 = (h7 + h) & _M32;
    }
    I64 hs[8] = {h0, h1, h2, h3, h4, h5, h6, h7};
    for I64 i = 0; i < 8; i++ {
        for I64 j = 0; j < 4; j++ {
            out[i * 4 + j] = ((hs[i] >> ((3 - j) * 8)) & 255) as U8;
        }
    }
}
