import "rt";
import "sys";

I64 _cur      = 0;
I64 _end      = 0;
I64 _free[32] = {};

const I64 _HEAP = 256 * 1024 * 1024;

I64 _base() {
    return sys.mmap(_HEAP);
}

I64 _size() {
    return _HEAP;
}

U0 _t(I64 kind) {
    U8* m = "heap: trap: ";
    rt.hc2_trap(m.addr, m.len, kind);
}

U0 _init() {
    if _cur == 0 {
        I64 b = _base();
        if b <= 0 {
            _t(rt.TK_OOM);
        }
        _cur = b;
        _end = b + _size();
    }
}

I64 _class(I64 n) {
    if n > _HEAP {
        _t(rt.TK_OOM);
    }
    I64 payload = (n + 15) / 16 * 16;
    I64 c = 4;
    for (1 << c) < payload {
        c = c + 1;
    }
    return c;
}

I64 _block_size(I64 c) {
    return (1 << c) + 32;
}

U8* alloc(I64 n) {
    _init();
    if n < 0 {
        _t(rt.TK_OOM);
    }
    I64 c = _class(n);
    I64 h = _free[c];
    if h != 0 {
        I64* w = sys.from_raw(h, 16) as I64*;
        _free[c] = w[0];
        U8* p = sys.from_raw(h + 16, n);
        for I64 i = 0; i < n; i++ {
            p[i] = 0 as U8;
        }
        return p;
    }
    I64 need = _block_size(c);
    if _cur + need > _end {
        _t(rt.TK_OOM);
    }
    I64 base = _cur;
    _cur = _cur + need;
    return sys.from_raw(base + 32, n);
}

U0 free(U8* p) {
    if p.gen == 0 {
        _t(rt.TK_IMMORTAL);
    }
    if p.lo != 0 {
        _t(rt.TK_NOTBASE);
    }
    if p.addr != p.hdr + 16 {
        _t(rt.TK_NOTBASE);
    }
    I64* h = sys.from_raw(p.hdr, 16) as I64*;
    if h[1] != p.gen {
        _t(rt.TK_DFREE);
    }
    h[1] = h[1] + 1;
    if p.hdr < _end - _size() || p.hdr >= _cur {
        return;
    }
    I64 c = _class(h[0] & 4294967295);
    h[0] = _free[c];
    _free[c] = p.hdr;
}
