import "heap";
import "str";

const I64 TK_EOF     = 0;
const I64 TK_IDENT   = 1;
const I64 TK_NUM     = 2;
const I64 TK_STR     = 3;
const I64 TK_PUNCT   = 4;
const I64 TK_COMMENT = 5;
const I64 TK_NL      = 6;
const I64 TK_MEM     = 7;

struct Tok {
    I64 kind;
    I64 line;
    I64 off;
    I64 tlen;
    I64 flag;
}

struct Lx {
    U8* src;
    Tok* toks;
    I64 ntok;
    I64 cap;
    I64 nlines;
    I64 pos;
    I64 line;
    I64 errline;
    U8* errmsg;
    I64 asmdepth;
    I64 asmnext;
}

Lx* lx_new(U8* src) {
    Lx* lx = heap.alloc(sizeof(Lx)) as Lx*;
    lx.src = src;
    lx.cap = src.len + 2;
    lx.toks = heap.alloc(lx.cap * sizeof(Tok)) as Tok*;
    lx.ntok = 0;
    lx.nlines = 1;
    lx.pos = 0;
    lx.line = 1;
    lx.errline = 0;
    lx.errmsg = "";
    lx.asmdepth = 0;
    lx.asmnext = 0;
    return lx;
}

U0 lx_free(Lx* lx) {
    heap.free(lx.toks as U8*);
}

U8* tok_text(Lx* lx, Tok* t) {
    return lx.src[t.off : t.off + t.tlen];
}

Bool is_id1(I64 c) {
    if c >= 'a' && c <= 'z' {
        return true;
    }
    if c >= 'A' && c <= 'Z' {
        return true;
    }
    return c == '_';
}

Bool is_dig(I64 c) {
    return c >= '0' && c <= '9';
}

Bool is_idn(I64 c) {
    return is_id1(c) || is_dig(c);
}

Bool is_hex(I64 c) {
    if is_dig(c) {
        return true;
    }
    if c >= 'a' && c <= 'f' {
        return true;
    }
    return c >= 'A' && c <= 'F';
}

Bool is_blank(I64 c) {
    return c == ' ' || c == '\t' || c == '\r';
}

Bool two_char_punct(I64 a, I64 b) {
    if a == '=' || a == '!' || a == '<' || a == '>' {
        return b == '=' || (a == b && (a == '<' || a == '>'));
    }
    if a == '+' || a == '-' || a == '&' || a == '|' {
        return a == b;
    }
    return false;
}

I64 _pk(Lx* lx, I64 at) {
    if at >= lx.src.len {
        return -1;
    }
    return lx.src[at] as I64;
}

U0 _fail(Lx* lx, U8* msg) {
    if lx.errline == 0 {
        lx.errline = lx.line;
        lx.errmsg = msg;
    }
}

U0 _push(Lx* lx, I64 kind, I64 off, I64 tlen) {
    if lx.ntok >= lx.cap {
        _fail(lx, "token table full");
        return;
    }
    Tok* t = lx.toks + lx.ntok;
    t.kind = kind;
    t.line = lx.line;
    t.off = off;
    t.tlen = tlen;
    t.flag = 0;
    lx.ntok = lx.ntok + 1;
    if kind == TK_NL || kind == TK_COMMENT {
        return;
    }
    if kind == TK_PUNCT && tlen == 1 {
        I64 c = lx.src[off] as I64;
        if c == '{' {
            if lx.asmnext == 1 {
                lx.asmdepth = 1;
            } else if lx.asmdepth > 0 {
                lx.asmdepth = lx.asmdepth + 1;
            }
        }
        if c == '}' && lx.asmdepth > 0 {
            lx.asmdepth = lx.asmdepth - 1;
        }
    }
    lx.asmnext = 0;
    if kind == TK_IDENT && str.eq(lx.src[off : off + tlen], "asm") {
        lx.asmnext = 1;
    }
}

U0 _comment(Lx* lx, I64 start) {
    I64 e = start;
    for _pk(lx, e) != -1 && _pk(lx, e) != '\n' {
        e = e + 1;
    }
    lx.pos = e;
    for e > start && is_blank(lx.src[e - 1] as I64) {
        e = e - 1;
    }
    _push(lx, TK_COMMENT, start, e - start);
}

U0 _memop(Lx* lx, I64 start) {
    I64 e = start + 1;
    for _pk(lx, e) != -1 && _pk(lx, e) != '\n' && _pk(lx, e) != ']' {
        e = e + 1;
    }
    if _pk(lx, e) != ']' {
        _fail(lx, "unterminated memory operand");
        return;
    }
    lx.pos = e + 1;
    _push(lx, TK_MEM, start, lx.pos - start);
}

U0 _number(Lx* lx, I64 start) {
    I64 p = start;
    if _pk(lx, p) == '0' && _pk(lx, p + 1) == 'x' {
        p = p + 2;
        for is_hex(_pk(lx, p)) {
            p = p + 1;
        }
    } else {
        for is_dig(_pk(lx, p)) {
            p = p + 1;
        }
        if _pk(lx, p) == '.' && is_dig(_pk(lx, p + 1)) {
            p = p + 1;
            for is_dig(_pk(lx, p)) {
                p = p + 1;
            }
        }
        if _pk(lx, p) == 'e' {
            I64 p2 = _pk(lx, p + 1);
            if is_dig(p2) || p2 == '+' || p2 == '-' {
                p = p + 1;
                if is_dig(_pk(lx, p)) == false {
                    p = p + 1;
                }
                for is_dig(_pk(lx, p)) {
                    p = p + 1;
                }
            }
        }
    }
    lx.pos = p;
    _push(lx, TK_NUM, start, p - start);
}

U0 _charlit(Lx* lx, I64 start) {
    I64 p = start + 1;
    I64 d = _pk(lx, p);
    if d == -1 || d == '\n' {
        _fail(lx, "unterminated character literal");
        return;
    }
    p = p + 1;
    if d == '\\' {
        p = p + 1;
    }
    if _pk(lx, p) != '\'' {
        _fail(lx, "expected closing quote");
        return;
    }
    lx.pos = p + 1;
    _push(lx, TK_NUM, start, lx.pos - start);
}

U0 _strlit(Lx* lx, I64 start) {
    I64 p = start + 1;
    for true {
        I64 d = _pk(lx, p);
        if d == -1 || d == '\n' {
            _fail(lx, "unterminated string literal");
            return;
        }
        p = p + 1;
        if d == '"' {
            break;
        }
        if d == '\\' {
            p = p + 1;
        }
    }
    lx.pos = p;
    _push(lx, TK_STR, start, p - start);
}

U0 _punct(Lx* lx, I64 start) {
    I64 c = _pk(lx, start);
    I64 n = 1;
    if c == '.' && _pk(lx, start + 1) == '.' && _pk(lx, start + 2) == '.' {
        n = 3;
    } else if two_char_punct(c, _pk(lx, start + 1)) {
        n = 2;
    }
    lx.pos = start + n;
    _push(lx, TK_PUNCT, start, n);
}

U0 lex_all(Lx* lx) {
    for lx.errline == 0 {
        I64 start = lx.pos;
        I64 c = _pk(lx, start);
        if c == -1 {
            _push(lx, TK_EOF, start, 0);
            return;
        }
        if c == '\n' {
            _push(lx, TK_NL, start, 1);
            lx.pos = start + 1;
            lx.line = lx.line + 1;
            lx.nlines = lx.nlines + 1;
        } else if is_blank(c) {
            lx.pos = start + 1;
        } else if c == '/' && _pk(lx, start + 1) == '/' {
            _comment(lx, start);
        } else if lx.asmdepth > 0 && c == '[' {
            _memop(lx, start);
        } else if is_id1(c) {
            for is_idn(_pk(lx, lx.pos)) {
                lx.pos = lx.pos + 1;
            }
            _push(lx, TK_IDENT, start, lx.pos - start);
        } else if is_dig(c) {
            _number(lx, start);
        } else if c == '\'' {
            _charlit(lx, start);
        } else if c == '"' {
            _strlit(lx, start);
        } else {
            _punct(lx, start);
        }
    }
}
