I32 main() {
    I32 m[2][3] = {{1, 2, 3}, {4, 5, 6}};
    "const %d %d\n", m[0][0], m[1][2];
    for I32 r = 0; r < 2; r++ {
        for I32 col = 0; col < 3; col++ {
            "%d ", m[r][col];
        }
    }
    "\n";
    m[1][0] = 40;
    I32 r2 = 1;
    "assigned %d\n", m[r2][0];
    I64 cube[2][2][2] = {{{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}};
    I64 i = 1;
    "cube %d %d\n", cube[1][0][1], cube[i][i][i];
    return 0;
}
