I32 main() {
    F64 x = 1.5;
    F64 y = x * 2.0 + 0.25;
    "%f\n", y;
    "%f\n", 0.1 + 0.2;
    "%f\n", 1.0 / 3.0;
    "%f\n", -2.5;
    F64 q = -1.5;
    "%f\n", -q;
    "%f\n", 3.14159265358979323846;
    "%f\n", 1.5e-3;
    "%f\n", 123456789.125;
    I64 t = 2.9 as I64;
    F64 ng = -2.9;
    "%d %d\n", t, ng as I64;
    "%f\n", 7 as I64 as F64;
    return 0;
}
