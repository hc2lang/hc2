import "heap";

struct Pt {
    I64 x;
    U8* name;
}

I32 main() {
    U8* mem = heap.alloc(sizeof(Pt));
    Pt* q = mem as Pt*;
    q.name = "hi";
    heap.free(mem);
    U8* again = heap.alloc(sizeof(Pt));
    if again.addr != mem.addr {
        "not reused\n";
        return 1;
    }
    for I64 i = 0; i < 40; i++ {
        again[i] = 0;
    }
    "bytes ok\n";
    return 0;
}
